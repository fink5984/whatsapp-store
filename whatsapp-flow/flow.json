{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "STORE_SEARCH": ["STORE_RESULTS"],
    "STORE_RESULTS": ["CATEGORY_SELECT"],
    "CATEGORY_SELECT": ["PRODUCT_SELECT"],
    "PRODUCT_SELECT": ["PRODUCT_CUSTOMIZE"],
    "PRODUCT_CUSTOMIZE": ["CART"],
    "CART": ["CATEGORY_SELECT", "DELIVERY_METHOD"],
    "DELIVERY_METHOD": ["CUSTOMER_DETAILS"],
    "CUSTOMER_DETAILS": ["ORDER_SUMMARY"],
    "ORDER_SUMMARY": ["PAYMENT_PENDING"],
    "PAYMENT_PENDING": ["ORDER_CONFIRMED"],
    "ORDER_CONFIRMED": []
  },
  "screens": [
    {
      "id": "STORE_SEARCH",
      "title": "מצא חנות",
      "data": {
        "title": { "type": "string", "__example__": "מצא חנות" },
        "subtitle": { "type": "string", "__example__": "חפש לפי שם, קוד או עיר" },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.title}" },
          { "type": "TextSubheading", "text": "${data.subtitle}" },
          {
            "type": "TextBody",
            "text": "${data.error_message}",
            "visible": "${data.has_error}"
          },
          {
            "type": "TextInput",
            "name": "query",
            "label": "שם החנות / קוד",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "city",
            "label": "עיר",
            "required": false
          },
          {
            "type": "TextInput",
            "name": "category",
            "label": "קטגוריה",
            "required": false
          },
          {
            "type": "Footer",
            "label": "חפש חנות",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "search_stores",
                "query": "${form.query}",
                "city": "${form.city}",
                "category": "${form.category}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "STORE_RESULTS",
      "title": "תוצאות חיפוש",
      "data": {
        "title": { "type": "string", "__example__": "נמצאו 3 חנויות" },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "s1", "title": "פיצה נאפולי", "description": "תל אביב · פיצריה" }
          ]
        },
        "query": { "type": "string", "__example__": "" },
        "city": { "type": "string", "__example__": "" },
        "category": { "type": "string", "__example__": "" },
        "selected_store_id": { "type": "string", "__example__": "" },
        "selected_title": { "type": "string", "__example__": "" },
        "selected_line_1": { "type": "string", "__example__": "" },
        "selected_line_2": { "type": "string", "__example__": "" },
        "selected_line_3": { "type": "string", "__example__": "" },
        "selected_line_4": { "type": "string", "__example__": "" },
        "has_line_1": { "type": "boolean", "__example__": false },
        "has_line_2": { "type": "boolean", "__example__": false },
        "has_line_3": { "type": "boolean", "__example__": false },
        "has_line_4": { "type": "boolean", "__example__": false },
        "has_selected": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.title}" },
          {
            "type": "RadioButtonsGroup",
            "name": "store_id",
            "label": "בחר חנות",
            "required": true,
            "init-value": "${data.selected_store_id}",
            "data-source": "${data.stores}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "step": "preview_store",
                "store_id": "${form.store_id}",
                "query": "${data.query}",
                "city": "${data.city}",
                "category": "${data.category}"
              }
            }
          },
          { "type": "TextSubheading", "text": "${data.selected_title}", "visible": "${data.has_selected}" },
          { "type": "TextBody", "text": "${data.selected_line_1}", "visible": "${data.has_line_1}" },
          { "type": "TextBody", "text": "${data.selected_line_2}", "visible": "${data.has_line_2}" },
          { "type": "TextBody", "text": "${data.selected_line_3}", "visible": "${data.has_line_3}" },
          { "type": "TextBody", "text": "${data.selected_line_4}", "visible": "${data.has_line_4}" },
          {
            "type": "Footer",
            "label": "בחר חנות",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "step": "select_store", "store_id": "${form.store_id}" }
            }
          }
        ]
      }
    },
    {
      "id": "CATEGORY_SELECT",
      "title": "קטגוריות",
      "data": {
        "title": { "type": "string", "__example__": "בחר קטגוריה" },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [{ "id": "c1", "title": "פיצות", "description": "" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.title}" },
          {
            "type": "RadioButtonsGroup",
            "name": "category_id",
            "label": "קטגוריה",
            "required": true,
            "data-source": "${data.categories}"
          },
          {
            "type": "Footer",
            "label": "המשך",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "get_products",
                "category_id": "${form.category_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PRODUCT_SELECT",
      "title": "מוצרים",
      "data": {
        "title": { "type": "string", "__example__": "מוצרים" },
        "category_name": { "type": "string", "__example__": "" },
        "category_id": { "type": "string", "__example__": "" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "metadata": { "type": "string" },
              "image": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "p1", "title": "מרגריטה", "description": "רוטב, מוצרלה", "metadata": "₪58" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.title}" },
          {
            "type": "RadioButtonsGroup",
            "name": "product_id",
            "label": "בחר מוצר",
            "required": true,
            "media-size": "large",
            "data-source": "${data.products}"
          },
          {
            "type": "Footer",
            "label": "בחר מוצר",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_product",
                "product_id": "${form.product_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PRODUCT_CUSTOMIZE",
      "title": "התאם את המוצר",
      "data": {
        "product_id": { "type": "string", "__example__": "" },
        "product_name": { "type": "string", "__example__": "פיצה מרגריטה" },
        "product_description": { "type": "string", "__example__": "" },
        "price": { "type": "string", "__example__": "₪58" },
        "max_quantity": { "type": "number", "__example__": 20 },
        "allow_note": { "type": "boolean", "__example__": true },
        "empty_array": { "type": "array", "items": { "type": "string" }, "__example__": [] },
        "empty_string": { "type": "string", "__example__": "" },
        "group_1": {
          "type": "object",
          "__example__": {
            "visible": true, "visible_single": true, "visible_multi": false,
            "name": "גודל", "use_multi": false, "is_required": false,
            "min_select": 0, "max_select": 1,
            "options": [{ "id": "g1o1", "title": "S" }]
          },
          "properties": {
            "visible": { "type": "boolean" },
            "visible_single": { "type": "boolean" },
            "visible_multi": { "type": "boolean" },
            "name": { "type": "string" },
            "use_multi": { "type": "boolean" },
            "is_required": { "type": "boolean" },
            "min_select": { "type": "number" },
            "max_select": { "type": "number" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              }
            }
          }
        },
        "group_2": {
          "type": "object",
          "__example__": { "visible": false, "visible_single": false, "visible_multi": false, "name": "", "use_multi": false, "is_required": false, "min_select": 0, "max_select": 1, "options": [] },
          "properties": {
            "visible": { "type": "boolean" },
            "visible_single": { "type": "boolean" },
            "visible_multi": { "type": "boolean" },
            "name": { "type": "string" },
            "use_multi": { "type": "boolean" },
            "is_required": { "type": "boolean" },
            "min_select": { "type": "number" },
            "max_select": { "type": "number" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              }
            }
          }
        },
        "group_3": {
          "type": "object",
          "__example__": { "visible": false, "visible_single": false, "visible_multi": false, "name": "", "use_multi": false, "is_required": false, "min_select": 0, "max_select": 1, "options": [] },
          "properties": {
            "visible": { "type": "boolean" },
            "visible_single": { "type": "boolean" },
            "visible_multi": { "type": "boolean" },
            "name": { "type": "string" },
            "use_multi": { "type": "boolean" },
            "is_required": { "type": "boolean" },
            "min_select": { "type": "number" },
            "max_select": { "type": "number" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              }
            }
          }
        },
        "group_4": {
          "type": "object",
          "__example__": { "visible": false, "visible_single": false, "visible_multi": false, "name": "", "use_multi": false, "is_required": false, "min_select": 0, "max_select": 1, "options": [] },
          "properties": {
            "visible": { "type": "boolean" },
            "visible_single": { "type": "boolean" },
            "visible_multi": { "type": "boolean" },
            "name": { "type": "string" },
            "use_multi": { "type": "boolean" },
            "is_required": { "type": "boolean" },
            "min_select": { "type": "number" },
            "max_select": { "type": "number" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              }
            }
          }
        },
        "group_5": {
          "type": "object",
          "__example__": { "visible": false, "visible_single": false, "visible_multi": false, "name": "", "use_multi": false, "is_required": false, "min_select": 0, "max_select": 1, "options": [] },
          "properties": {
            "visible": { "type": "boolean" },
            "visible_single": { "type": "boolean" },
            "visible_multi": { "type": "boolean" },
            "name": { "type": "string" },
            "use_multi": { "type": "boolean" },
            "is_required": { "type": "boolean" },
            "min_select": { "type": "number" },
            "max_select": { "type": "number" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.product_name}" },
          { "type": "TextBody", "text": "${data.product_description}" },
          { "type": "TextBody", "text": "${data.price}" },

          {
            "type": "TextInput",
            "name": "quantity",
            "label": "כמות",
            "input-type": "number",
            "init-value": "1",
            "required": true
          },

          { "type": "TextSubheading", "text": "${data.group_1.name}", "visible": "${data.group_1.visible}" },
          { "type": "RadioButtonsGroup", "name": "group_1_single", "label": "בחר", "visible": "${data.group_1.visible_single}", "init-value": "${data.empty_string}", "data-source": "${data.group_1.options}" },
          { "type": "CheckboxGroup", "name": "group_1_multi", "label": "בחר", "visible": "${data.group_1.visible_multi}", "init-value": "${data.empty_array}", "min-selected-items": "${data.group_1.min_select}", "max-selected-items": "${data.group_1.max_select}", "data-source": "${data.group_1.options}" },

          { "type": "TextSubheading", "text": "${data.group_2.name}", "visible": "${data.group_2.visible}" },
          { "type": "RadioButtonsGroup", "name": "group_2_single", "label": "בחר", "visible": "${data.group_2.visible_single}", "init-value": "${data.empty_string}", "data-source": "${data.group_2.options}" },
          { "type": "CheckboxGroup", "name": "group_2_multi", "label": "בחר", "visible": "${data.group_2.visible_multi}", "init-value": "${data.empty_array}", "min-selected-items": "${data.group_2.min_select}", "max-selected-items": "${data.group_2.max_select}", "data-source": "${data.group_2.options}" },

          { "type": "TextSubheading", "text": "${data.group_3.name}", "visible": "${data.group_3.visible}" },
          { "type": "RadioButtonsGroup", "name": "group_3_single", "label": "בחר", "visible": "${data.group_3.visible_single}", "init-value": "${data.empty_string}", "data-source": "${data.group_3.options}" },
          { "type": "CheckboxGroup", "name": "group_3_multi", "label": "בחר", "visible": "${data.group_3.visible_multi}", "init-value": "${data.empty_array}", "min-selected-items": "${data.group_3.min_select}", "max-selected-items": "${data.group_3.max_select}", "data-source": "${data.group_3.options}" },

          { "type": "TextSubheading", "text": "${data.group_4.name}", "visible": "${data.group_4.visible}" },
          { "type": "RadioButtonsGroup", "name": "group_4_single", "label": "בחר", "visible": "${data.group_4.visible_single}", "init-value": "${data.empty_string}", "data-source": "${data.group_4.options}" },
          { "type": "CheckboxGroup", "name": "group_4_multi", "label": "בחר", "visible": "${data.group_4.visible_multi}", "init-value": "${data.empty_array}", "min-selected-items": "${data.group_4.min_select}", "max-selected-items": "${data.group_4.max_select}", "data-source": "${data.group_4.options}" },

          { "type": "TextSubheading", "text": "${data.group_5.name}", "visible": "${data.group_5.visible}" },
          { "type": "RadioButtonsGroup", "name": "group_5_single", "label": "בחר", "visible": "${data.group_5.visible_single}", "init-value": "${data.empty_string}", "data-source": "${data.group_5.options}" },
          { "type": "CheckboxGroup", "name": "group_5_multi", "label": "בחר", "visible": "${data.group_5.visible_multi}", "init-value": "${data.empty_array}", "min-selected-items": "${data.group_5.min_select}", "max-selected-items": "${data.group_5.max_select}", "data-source": "${data.group_5.options}" },

          { "type": "TextInput", "name": "note", "label": "הערה", "required": false, "visible": "${data.allow_note}", "init-value": "${data.empty_string}" },

          {
            "type": "Footer",
            "label": "הוסף לעגלה",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "add_to_cart",
                "product_id": "${data.product_id}",
                "quantity": "${form.quantity}",
                "group_1_single": "${form.group_1_single}",
                "group_1_multi": "${form.group_1_multi}",
                "group_2_single": "${form.group_2_single}",
                "group_2_multi": "${form.group_2_multi}",
                "group_3_single": "${form.group_3_single}",
                "group_3_multi": "${form.group_3_multi}",
                "group_4_single": "${form.group_4_single}",
                "group_4_multi": "${form.group_4_multi}",
                "group_5_single": "${form.group_5_single}",
                "group_5_multi": "${form.group_5_multi}",
                "note": "${form.note}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CART",
      "title": "העגלה שלך",
      "refresh_on_back": true,
      "data": {
        "is_empty": { "type": "boolean", "__example__": false },
        "has_items": { "type": "boolean", "__example__": true },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "ci_1", "title": "1 × פיצה מרגריטה", "description": "₪58" }
          ]
        },
        "total_text": { "type": "string", "__example__": "סך הכל: ₪58" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "העגלה שלך" },
          {
            "type": "CheckboxGroup",
            "name": "items_to_remove",
            "label": "בחר פריטים להסרה (אופציונלי)",
            "visible": "${data.has_items}",
            "required": false,
            "data-source": "${data.items}"
          },
          { "type": "TextSubheading", "text": "${data.total_text}" },
          {
            "type": "RadioButtonsGroup",
            "name": "cart_action",
            "label": "מה תרצה לעשות?",
            "required": true,
            "data-source": [
              { "id": "checkout", "title": "המשך להזמנה" },
              { "id": "add_more", "title": "הוסף מוצר נוסף" },
              { "id": "remove_items", "title": "הסר פריטים שסומנו" },
              { "id": "clear_cart", "title": "נקה עגלה" }
            ]
          },
          {
            "type": "Footer",
            "label": "המשך",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "${form.cart_action}",
                "items_to_remove": "${form.items_to_remove}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DELIVERY_METHOD",
      "title": "אופן ההזמנה",
      "data": {
        "store_id": { "type": "string", "__example__": "" },
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "delivery", "title": "משלוח לכתובת" },
            { "id": "pickup", "title": "איסוף עצמי" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "איך תרצה לקבל?" },
          {
            "type": "RadioButtonsGroup",
            "name": "delivery_type",
            "label": "בחר",
            "required": true,
            "data-source": "${data.methods}"
          },
          {
            "type": "Footer",
            "label": "המשך",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "set_delivery_method",
                "delivery_type": "${form.delivery_type}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CUSTOMER_DETAILS",
      "title": "פרטי הלקוח",
      "data": {
        "is_delivery": { "type": "boolean", "__example__": true },
        "customer_name": { "type": "string", "__example__": "" },
        "customer_phone": { "type": "string", "__example__": "" },
        "customer_email": { "type": "string", "__example__": "" },
        "city": { "type": "string", "__example__": "" },
        "address": { "type": "string", "__example__": "" },
        "floor": { "type": "string", "__example__": "" },
        "apartment": { "type": "string", "__example__": "" },
        "note": { "type": "string", "__example__": "" },
        "error_message": { "type": "string", "__example__": "" },
        "has_error": { "type": "boolean", "__example__": false }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "פרטי הלקוח" },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          { "type": "TextInput", "name": "customer_name", "label": "שם מלא", "required": true, "init-value": "${data.customer_name}" },
          { "type": "TextInput", "name": "customer_phone", "label": "טלפון", "input-type": "phone", "required": true, "init-value": "${data.customer_phone}" },
          { "type": "TextInput", "name": "customer_email", "label": "אימייל", "input-type": "email", "required": false, "init-value": "${data.customer_email}" },
          { "type": "TextInput", "name": "city", "label": "עיר", "required": false, "init-value": "${data.city}", "visible": "${data.is_delivery}" },
          { "type": "TextInput", "name": "address", "label": "כתובת", "required": false, "init-value": "${data.address}", "visible": "${data.is_delivery}" },
          { "type": "TextInput", "name": "floor", "label": "קומה", "required": false, "init-value": "${data.floor}", "visible": "${data.is_delivery}" },
          { "type": "TextInput", "name": "apartment", "label": "דירה", "required": false, "init-value": "${data.apartment}", "visible": "${data.is_delivery}" },
          { "type": "TextInput", "name": "note", "label": "הערה לבית העסק", "required": false, "init-value": "${data.note}" },
          {
            "type": "Footer",
            "label": "המשך לסיכום",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "validate_customer_details",
                "customer_name": "${form.customer_name}",
                "customer_phone": "${form.customer_phone}",
                "customer_email": "${form.customer_email}",
                "city": "${form.city}",
                "address": "${form.address}",
                "floor": "${form.floor}",
                "apartment": "${form.apartment}",
                "note": "${form.note}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ORDER_SUMMARY",
      "title": "סיכום הזמנה",
      "data": {
        "order_summary": { "type": "string", "__example__": "" },
        "subtotal_text": { "type": "string", "__example__": "סכום ביניים: ₪0" },
        "delivery_fee_text": { "type": "string", "__example__": "משלוח: ₪0" },
        "total_text": { "type": "string", "__example__": "סך הכל: ₪0" },
        "customer_line": { "type": "string", "__example__": "" },
        "address": { "type": "string", "__example__": "" },
        "estimated_text": { "type": "string", "__example__": "זמן הכנה משוער: 30 דקות" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "סיכום הזמנה" },
          { "type": "TextBody", "text": "${data.order_summary}" },
          { "type": "TextSubheading", "text": "${data.subtotal_text}" },
          { "type": "TextSubheading", "text": "${data.delivery_fee_text}" },
          { "type": "TextSubheading", "text": "${data.total_text}" },
          { "type": "TextBody", "text": "${data.customer_line}" },
          { "type": "TextBody", "text": "${data.address}" },
          { "type": "TextBody", "text": "${data.estimated_text}" },
          {
            "type": "Footer",
            "label": "המשך לתשלום",
            "on-click-action": {
              "name": "data_exchange",
              "payload": { "step": "create_payment" }
            }
          }
        ]
      }
    },
    {
      "id": "PAYMENT_PENDING",
      "title": "תשלום",
      "data": {
        "headline": { "type": "string", "__example__": "מעבר לתשלום" },
        "body": { "type": "string", "__example__": "פתח את דף התשלום, השלם את התשלום, ואז חזור לכאן ולחץ על בדוק תשלום." },
        "payment_url": { "type": "string", "__example__": "https://example.com/pay/123" },
        "payment_id": { "type": "string", "__example__": "00000000-0000-0000-0000-000000000000" },
        "order_draft_id": { "type": "string", "__example__": "00000000-0000-0000-0000-000000000000" },
        "store_id": { "type": "string", "__example__": "00000000-0000-0000-0000-000000000000" },
        "amount_text": { "type": "string", "__example__": "סכום לתשלום: ₪0" },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.headline}" },
          { "type": "TextSubheading", "text": "${data.amount_text}" },
          {
            "type": "EmbeddedLink",
            "text": "שלם עכשיו — פתח דף תשלום",
            "on-click-action": {
              "name": "open_url",
              "url": "${data.payment_url}"
            }
          },
          { "type": "TextBody", "text": "${data.body}" },
          { "type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}" },
          {
            "type": "Footer",
            "label": "בדוק תשלום",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "check_payment_status",
                "store_id": "${data.store_id}",
                "order_draft_id": "${data.order_draft_id}",
                "payment_id": "${data.payment_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ORDER_CONFIRMED",
      "title": "סיום",
      "terminal": true,
      "refresh_on_back": true,
      "data": {
        "headline": { "type": "string", "__example__": "ההזמנה התקבלה" },
        "body": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.headline}" },
          { "type": "TextBody", "text": "${data.body}" }
        ]
      }
    }
  ]
}
