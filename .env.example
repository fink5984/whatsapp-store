# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# WhatsApp Flow encryption (RSA private key, PEM format)
# Paste the full key — use \n for newlines or wrap with quotes.
WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEv...\n-----END RSA PRIVATE KEY-----"
# Optional passphrase if the private key is encrypted
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=

# Optional webhook receiver for order notifications
ORDER_NOTIFICATION_WEBHOOK_URL=

# Public base URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:3005
